{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerView",
  "version": "0.5.0",
  "identifier": "com.terview.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TerView",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "LeoMael",
    "copyright": "© 2026 LeoMael",
    "homepage": "https://github.com/LeoMael/TerView",
    "category": "DeveloperTool",
    "shortDescription": "Cliente SSH/SFTP visual",
    "longDescription": "TerView es un cliente SSH/SFTP de escritorio: terminal integrada, explorador y editor de archivos remotos, transferencias masivas, biblioteca de comandos y servidores y proyectos guardados, con reconexión automática y contraseñas en el llavero del sistema.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3NTM2QzdDQ0E2RkI3ODYKUldTR3QyL0tmR3hUWjBPRGxxZm1PQjNTM1NDQVFCY2s5bS9ISSs2dVk4eXhWSzRkTGsza2ZvdU8K",
      "endpoints": [
        "https://github.com/LeoMael/TerView/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
