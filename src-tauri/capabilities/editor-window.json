{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor-window",
  "description": "Ventanas de editor aparte (editor-*): eventos con la principal, título, foco y cierre",
  "windows": [
    "editor-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-destroy"
  ]
}
